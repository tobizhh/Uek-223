{
	"name": "Java",
	"image": "mcr.microsoft.com/devcontainers/java:3-25-bookworm",
	"features": {
		"ghcr.io/devcontainers/features/java:1": {
			"version": "none",
			"installMaven": "true",
			"mavenVersion": "latest",
			"installGradle": "false"
		}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"vscjava.vscode-java-pack",
				"redhat.vscode-quarkus"
			]
		}
	},
	"forwardPorts": [8080, 5005],
	"remoteUser": "vscode"
}
